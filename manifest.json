{
  "manifest_version": 3,
  "name": "Civitai Helper",
  "version": "1.5.7",
  "description": "Saves high-res images, generation prompts and metadata from Civitai with organized filenames. Active on \"civitai.com/images/*\" and \"civitai.red/images/*\" URL's" ,
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/icon48.png"
  },
  "permissions": ["downloads", "scripting", "activeTab", "storage"],
  "host_permissions": [
    "*://civitai.com/*",
    "*://civitai.red/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}


